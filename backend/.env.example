# Entorno del servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL 8
DATABASE_URL="mysql://usuario:clave@localhost:3306/rifas"
DATABASE_URL_TEST="mysql://usuario:clave@localhost:3306/rifas_test"

# Autenticacion JWT (usar cadenas largas aleatorias y distintas entre si)
JWT_ACCESS_SECRET="reemplazar-con-secreto-largo-para-access-token"
JWT_REFRESH_SECRET="reemplazar-con-secreto-largo-para-refresh-token"
ACCESS_TTL=15m
REFRESH_TTL=7d

# Reglas de negocio
TARIFA_PUBLICACION=0
RESERVA_MINUTOS=15
MAX_TICKETS_POR_RESERVA=10

# Administrador inicial para prisma/seed.js
ADMIN_EMAIL=admin@ejemplo.local
ADMIN_PASSWORD=CambiaEstaClaveSegura123
